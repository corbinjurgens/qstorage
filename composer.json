{
    "name": "corbinjurgens/q",
    "description": "Object-oriented, path-bound and key-bound wrappers around Laravel's Storage and Cache.",
    "keywords": ["laravel", "storage", "cache", "filesystem", "object-oriented", "fluent", "wrapper"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Corbin Jurgens",
            "email": "corbinjurgens@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.2",
        "illuminate/support": "^5.5 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/filesystem": "^5.5 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/cache": "^5.5 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^4.0 || ^5.0 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^8.0 || ^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Corbinjurgens\\Q\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Corbinjurgens\\Q\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Corbinjurgens\\Q\\ServiceProvider"
            ],
            "aliases": {
                "QStorage": "Corbinjurgens\\Q\\Facades\\QStorage",
                "QCache": "Corbinjurgens\\Q\\Facades\\QCache"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
